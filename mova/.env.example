# ── Database (Supabase Postgres or any PostgreSQL 14+) ──
# Supabase: Project Settings → Database → Connection string (use the pooled "Transaction" URL in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mova

# ── Auth ── generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# First admin account (used by `npm run db:seed` and `npm run admin:create`)
ADMIN_EMAIL=admin@mova.in
ADMIN_PASSWORD=ChangeMe!2026

# Public site URL (used for SEO, canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Image storage (Supabase Storage) ──
# Leave empty in local dev to store uploads in /public/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# ── Razorpay ── Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Allow a simulated payment when Razorpay keys are missing (NEVER true in production)
ALLOW_MOCK_PAYMENTS=true
